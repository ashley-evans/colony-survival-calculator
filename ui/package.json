{
    "name": "@colony-survival-calculator/ui",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "dev": "vite",
        "dev:open": "vite --open",
        "build": "run -T tsc && vite build",
        "deploy": "./scripts/deploy.sh",
        "deploy:plan": "./scripts/deploy.sh -d",
        "preview": "vite preview",
        "validate": "../scripts/validate-terraform.sh -r ./infra/",
        "format:check": "run -T prettier --check . && terraform fmt -recursive -check -diff ./infra/",
        "format:write": "run -T prettier --write . && terraform fmt -recursive ./infra/",
        "lint": "run -T eslint --max-warnings 0 . ",
        "lint:packages": "run -T npmPkgJsonLint .",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "generate": "graphql-codegen --config ./codegen.ts",
        "postinstall": "yarn generate"
    },
    "dependencies": {
        "@apollo/client": "4.2.12",
        "@fontsource/roboto-mono": "5.3.0",
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-brands-svg-icons": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/react-fontawesome": "3.5.0",
        "@nivo/core": "0.99.0",
        "@nivo/sankey": "0.99.0",
        "@smithy/signature-v4": "5.7.3",
        "aws-amplify": "6.20.0",
        "downshift": "9.4.0",
        "graphql": "17.0.2",
        "i18next": "26.4.0",
        "i18next-browser-languagedetector": "8.2.1",
        "i18next-http-backend": "4.0.1",
        "immutability-helper": "3.1.1",
        "normalize.css": "8.0.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-i18next": "17.0.12",
        "react-router-dom": "7.18.2",
        "styled-components": "6.5.3",
        "url": "0.11.4",
        "use-debounce": "10.1.1"
    },
    "devDependencies": {
        "@colony-survival-calculator/api": "workspace:^",
        "@graphql-codegen/cli": "^7.3.1",
        "@graphql-codegen/client-preset": "^6.1.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/styled-components": "^5.1.36",
        "@vitejs/plugin-react": "^6.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-refresh": "^0.5.4",
        "jsdom": "^30.0.1",
        "msw": "^2.15.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
